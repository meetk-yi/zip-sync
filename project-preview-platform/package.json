{
  "name": "project-preview-platform",
  "version": "1.0.0",
  "description": "Full stack application for uploading, building, and previewing React/Next.js projects",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "yauzl": "^2.10.0",
    "cors": "^2.8.5",
    "uuid": "^9.0.0",
    "fs-extra": "^11.1.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.1.5",
    "child_process": "^1.0.2",
    "path": "^0.12.7",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "concurrently": "^8.0.1"
  },
  "keywords": [
    "react",
    "nextjs",
    "preview",
    "upload",
    "build",
    "full-stack"
  ],
  "author": "",
  "license": "MIT"
}
